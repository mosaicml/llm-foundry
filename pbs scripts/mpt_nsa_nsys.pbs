#!/bin/bash
#PBS -l select=1:ngpus=2
#PBS -l walltime=12:00:00
#PBS -N llmfoundry_nsa_profile
#PBS -o out_nsa.txt
#PBS -j oe
#PBS -q ic102
#PBS -P 71001002

# Exit on any error
set -e

# Deactivate any existing env and activate LLM Foundry virtual env
deactivate || true
cd llm-foundry/
source .venv/bin/activate 
cd scripts

# NCCL safety exports
export NCCL_ASYNC_ERROR_HANDLING=1  
export TORCH_NCCL_BLOCKING_WAIT_TIMEOUT_MS=900000 

# Output profile path
PROFILE_OUTPUT_DIR="/home/users/nus/e1113744/scratch"
PROFILE_NAME="llmfoundry_nsa_profile"

# Run with NVIDIA Nsight Systems profiler
PATH=$HOME/nsight-systems-2025.3.1/bin:$PATH \
nsys profile \
  -o /home/users/nus/e1113744/scratch/llmfoundry_nsa_profile \
  --trace=cuda,nvtx,osrt \
  --force-overwrite=true \
  --capture-range=cudaProfilerApi \
  composer train/train.py \
    train/yamls/pretrain/mpt-350m-nsa-nsys.yaml \
    variables.data_local=/home/users/nus/e1113744/scratch/c4_long_seq \
    train_loader.dataset.split=train \
    eval_loader.dataset.split=val \
    max_duration=30ba \
    eval_interval=0 \
    save_folder=mpt-350m-nsa >> out_nsa.txt




